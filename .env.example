# Transactional email (required for /api/contact and /api/booking)
RESEND_API_KEY=

# Optional but recommended: secret used to sign the "what is 3 + 4?" form
# challenge. Any long random string works. When unset, RESEND_API_KEY is used
# as the signing key so tokens still verify across serverless instances.
FORM_CHALLENGE_SECRET=

# Optional: Cloudflare Turnstile (free CAPTCHA alternative).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile with the
# site domain, then set BOTH keys in Vercel → Project → Settings → Environment
# Variables and redeploy. When unset, the forms still run the built-in
# defenses (honeypot, timing, gibberish filter, same-origin, rate limit).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional overrides
# NEXT_PUBLIC_SITE_URL=https://jysadventuretour.com
# NEXT_PUBLIC_GA_ID=
